Configure webpage
URL=your-domain.com
WEBPAGE_TITLE=Your Website Title

#Configure Map
LATITUDE=42.173996
LONGITUDE=-71.60191
MAP_ZOOM=13

#TBI: Control where the home page is the "dashboard" or "landing" page
HOMEPAGE=landing

#TBI: Enable/disable optional website features
CHATBOT_ENABLED=true
ALERTS_ENABLED=true

#API keys
OPENAI_API_KEY=create account at https://openai.com/api/ and buy 5$ worth of tokens to get api access and generate a key
PURPLEAIR_API_KEY=create account at https://develop.purpleair.com/sign-in?redirectURL=%2Fdashboards%2Forganization to get api access and generate a key
EMAIL_PASSWORD=create a gmail account and generate an "app password" to put here

#Signs CSRF tokens - set this to your own random string (e.g. `openssl rand -hex 32`).
#If left unset the server generates a random one on every restart, which invalidates
#any CSRF tokens issued before the restart.
SECRET_KEY=replace with a long random string

