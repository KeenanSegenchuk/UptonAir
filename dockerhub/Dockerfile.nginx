# dockerhub/Dockerfile.nginx
# Build context is the repo root (see dockerhub/docker-compose.yml: build.context: ..)
FROM nginx:alpine

# Copy over config into image
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Copy over static react build (baked in, not bind-mounted — see UPDATE.txt)
COPY client/build /etc/nginx/html

# Expose ports for http/https
EXPOSE 443
EXPOSE 80

# Launch server
CMD ["nginx", "-g", "daemon off;"]
